# Copy this file to .env and paste your key.
# Free Gemini key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=paste-your-key-here

# Which model the agent uses ("provider:model"). Change this one line to switch.
MODEL=google_genai:gemini-3-flash-preview
# If Google retires a model name, run: python -m churn_agent.list_models
# MODEL=openai:gpt-4o-mini        (needs OPENAI_API_KEY and: pip install langchain-openai)
# MODEL=anthropic:claude-haiku-4-5  (needs ANTHROPIC_API_KEY and: pip install langchain-anthropic)

# Use keyword search instead of the local embedding model (e.g. offline):
# RETRIEVER=keyword
